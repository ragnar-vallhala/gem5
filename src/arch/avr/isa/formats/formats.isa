def format Basic(code, *opt_args) {{
    iop = InstObjParams(name, Name, 'BasicOp',
                       {'code': code, 'predicate_test': predicateTest},
                       opt_args)
    header_output = BasicDeclare.subst(iop)
    decoder_output = BasicConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = BasicExecute.subst(iop)
}};



def format Unimplemented(code, *opt_args) {{
    iop = InstObjParams(name, Name, 'UnimplementedOp',
                       {'code': code, 'predicate_test': predicateTest, 'name': name},
                       opt_args)
    header_output = UnknownDeclare.subst(iop)
    decoder_output = UnknownConstructor.subst(iop)
    decode_block = UnknownDecode.subst(iop)
    exec_output = UnknownExecute.subst(iop)
}};

def format Basic4Byte(code, *opt_args) {{
    iop = InstObjParams(name, Name, 'AVRStaticInst',
                       {'code': code, 'predicate_test': predicateTest},
                       opt_args)
    header_output = Basic4ByteDeclare.subst(iop)
    decoder_output = Basic4ByteConstructor.subst(iop)
    decode_block = Basic4ByteDecode.subst(iop)
    exec_output = Basic4ByteExecute.subst(iop)
}};
