    // SBRS/SBRC/BLD/BST/ICALL
    // SBRS/SBRC: 1111 11br rrrr 0bbb (OP=0x3f, BIT9=1/0)
    // BLD: 1111 100d dddd 0bbb (OP=0x3e, BIT9=0)
    // BST: 1111 101d dddd 0bbb (OP=0x3e, BIT9=1)

    0x3e: decode BIT9 {
        0x0: Basic::bld({{
            uint8_t rd_idx = (machInst >> 4) & 0x1F;
            uint8_t bit = (machInst & 0x07);
            uint8_t sreg = xc->readMiscReg(AVRISAInst::MISCREG_SREG);
            uint8_t t_flag = (sreg >> AVRISAInst::SREG_T) & 1;
            RegVal rd = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, rd_idx));
            if (t_flag) {
                rd |= (1 << bit);
            } else {
                rd &= ~(1 << bit);
            }
            xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, rd_idx), rd);
        }});
        0x1: Basic::bst({{
            uint8_t rd_idx = (machInst >> 4) & 0x1F;
            uint8_t bit = (machInst & 0x07);
            RegVal rd = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, rd_idx));
            uint8_t sreg = xc->readMiscReg(AVRISAInst::MISCREG_SREG);
            if ((rd >> bit) & 1) {
                sreg |= (1 << AVRISAInst::SREG_T);
            } else {
                sreg &= ~(1 << AVRISAInst::SREG_T);
            }
            xc->setMiscReg(AVRISAInst::MISCREG_SREG, sreg);
        }});
        default: Unimplemented::bld_bst_default({{ return nullptr; }});
    }

    0x3f: decode BIT9 {
        0x1: Basic::sbrs({{
            uint8_t rd_idx = (machInst >> 4) & 0x1F;
            uint8_t bit = (machInst & 0x07);
            RegVal rd = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, rd_idx));
            if ((rd >> bit) & 1) {
                gem5::AVRISAInst::PCState pc = xc->pcState().as<gem5::AVRISAInst::PCState>();
                pc.advance();
                xc->pcState(pc);
            }
        }});
        0x0: Basic::sbrc({{
            uint8_t rd_idx = (machInst >> 4) & 0x1F;
            uint8_t bit = (machInst & 0x07);
            RegVal rd = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, rd_idx));
            if (!((rd >> bit) & 1)) {
                gem5::AVRISAInst::PCState pc = xc->pcState().as<gem5::AVRISAInst::PCState>();
                pc.advance();
                xc->pcState(pc);
            }
        }});
        default: Unimplemented::sbrs_bit9_default({{ return nullptr; }});
    }
