// decoder.isa

decode OPCODE default Unimplemented::opcode_default({{
    return nullptr;
}}) {

    0x00: decode BIT9 {
        0x0: decode BIT8 {
            0x0: Basic::nop({{ }});
            0x1: Movw::movw({{ }});
            default: Unimplemented::op00_bit8_default({{ return nullptr; }});
        }
        0x1: decode BIT8 {
            // MULS: 0000 0010 dddd rrrr -- signed*signed, Rd,Rr in r16..r31.
            0x0: Basic::muls({{
                uint8_t rd_idx = 16 + ((machInst >> 4) & 0x0F);
                uint8_t rr_idx = 16 + (machInst & 0x0F);
                int8_t rd = (int8_t)(uint8_t)xc->tcBase()->getReg(
                    RegId(AVRISAInst::intRegClass, rd_idx));
                int8_t rr = (int8_t)(uint8_t)xc->tcBase()->getReg(
                    RegId(AVRISAInst::intRegClass, rr_idx));
                uint16_t res = (uint16_t)((int16_t)rd * (int16_t)rr);
                xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, 0),
                                     (RegVal)(res & 0xFF));
                xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, 1),
                                     (RegVal)((res >> 8) & 0xFF));
                uint8_t sreg = xc->readMiscReg(AVRISAInst::MISCREG_SREG);
                if (res & 0x8000) sreg |= (1 << AVRISAInst::SREG_C);
                else sreg &= ~(1 << AVRISAInst::SREG_C);
                if (res == 0) sreg |= (1 << AVRISAInst::SREG_Z);
                else sreg &= ~(1 << AVRISAInst::SREG_Z);
                xc->setMiscReg(AVRISAInst::MISCREG_SREG, sreg);
            }});
            // 0000 0011 .ddd .rrr -- MULSU / FMUL / FMULS / FMULSU,
            // Rd,Rr in r16..r23, selected by bit7 (signed Rd) and bit3 (frac).
            0x1: Basic::mulsu_fmul({{
                uint8_t rd_idx = 16 + ((machInst >> 4) & 0x07);
                uint8_t rr_idx = 16 + (machInst & 0x07);
                uint8_t du = (uint8_t)xc->tcBase()->getReg(
                    RegId(AVRISAInst::intRegClass, rd_idx));
                uint8_t ru = (uint8_t)xc->tcBase()->getReg(
                    RegId(AVRISAInst::intRegClass, rr_idx));
                bool sgnd = (machInst >> 7) & 1; // bit7
                bool frac = (machInst >> 3) & 1; // bit3
                int16_t prod;
                if (!sgnd && !frac) // MULSU: signed Rd * unsigned Rr
                    prod = (int16_t)((int8_t)du) * (int16_t)((uint8_t)ru);
                else if (!sgnd && frac) // FMUL: unsigned * unsigned
                    prod = (int16_t)((uint16_t)du * (uint16_t)ru);
                else if (sgnd && !frac) // FMULS: signed * signed
                    prod = (int16_t)((int8_t)du) * (int16_t)((int8_t)ru);
                else // FMULSU: signed Rd * unsigned Rr
                    prod = (int16_t)((int8_t)du) * (int16_t)((uint8_t)ru);
                uint8_t sreg = xc->readMiscReg(AVRISAInst::MISCREG_SREG);
                // Carry is bit15 of the product (pre-shift for the fractional
                // forms, which then left-shift the result by one).
                if ((uint16_t)prod & 0x8000) sreg |= (1 << AVRISAInst::SREG_C);
                else sreg &= ~(1 << AVRISAInst::SREG_C);
                // Of this 0x03xx block only MULSU (bit7=0, bit3=0) is a plain
                // (non-fractional) product; FMUL, FMULS and FMULSU all left-shift
                // the result by one. bit3 alone misclassifies FMULS (bit7=1,
                // bit3=0), so shift whenever it is not MULSU.
                bool is_mulsu = !sgnd && !frac;
                uint16_t res = is_mulsu ? (uint16_t)prod
                                        : (uint16_t)((uint16_t)prod << 1);
                xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, 0),
                                     (RegVal)(res & 0xFF));
                xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, 1),
                                     (RegVal)((res >> 8) & 0xFF));
                if (res == 0) sreg |= (1 << AVRISAInst::SREG_Z);
                else sreg &= ~(1 << AVRISAInst::SREG_Z);
                xc->setMiscReg(AVRISAInst::MISCREG_SREG, sreg);
            }});
            default: Unimplemented::op00_mul_default({{ return nullptr; }});
        }
        default: Unimplemented::op00_ident_default({{ return nullptr; }});
    }
    0x01: Cpc::cpc({{ }});
    0x02: Sbc::sbc({{ }});
    0x03: Add::add({{ }});
    0x05: Cp::cp({{ }});
    0x04: Basic::cpse({{
        uint8_t rr_idx = (EOR_RH << 4) | EOR_RL;
        uint8_t rd_idx = EOR_D;
        RegVal rd = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, rd_idx));
        RegVal rr = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, rr_idx));
        if (rd == rr) {
            gem5::AVRISAInst::PCState pc = xc->pcState().as<gem5::AVRISAInst::PCState>();
            pc.advance(); // Skip one instruction
            xc->pcState(pc);
        }
    }});
    0x06: Sub::sub({{ }});
    0x07: Adc::adc({{ }});
    0x08: And::and({{ }});
    0x09: Eor::eor({{ }});
    0x0a: Or::or({{ }});
    0x0b: Mov::mov({{ }});

    0x18, 0x19, 0x1a, 0x1b: Basic::ori({{
        uint8_t imm = (LDI_KH << 4) | LDI_KL;
        uint8_t rd = 16 + LDI_D;
        RegVal rd_val = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, rd));
        uint8_t result = (uint8_t)rd_val | imm;
        uint8_t sreg = xc->readMiscReg(AVRISAInst::MISCREG_SREG);
        sreg &= ~(1 << AVRISAInst::SREG_V);
        if (result == 0) sreg |= (1 << AVRISAInst::SREG_Z); else sreg &= ~(1 << AVRISAInst::SREG_Z);
        if (result & 0x80) sreg |= (1 << AVRISAInst::SREG_N); else sreg &= ~(1 << AVRISAInst::SREG_N);
        bool s = ((sreg >> AVRISAInst::SREG_N) & 1) ^ ((sreg >> AVRISAInst::SREG_V) & 1);
        if (s) sreg |= (1 << AVRISAInst::SREG_S); else sreg &= ~(1 << AVRISAInst::SREG_S);
        xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, rd), result);
        xc->setMiscReg(AVRISAInst::MISCREG_SREG, sreg);
    }});
    0x1c, 0x1d, 0x1e, 0x1f: Basic::andi({{
        uint8_t imm = (LDI_KH << 4) | LDI_KL;
        uint8_t rd = 16 + LDI_D;
        RegVal rd_val = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, rd));
        uint8_t result = (uint8_t)rd_val & imm;
        uint8_t sreg = xc->readMiscReg(AVRISAInst::MISCREG_SREG);
        sreg &= ~(1 << AVRISAInst::SREG_V);
        if (result == 0) sreg |= (1 << AVRISAInst::SREG_Z); else sreg &= ~(1 << AVRISAInst::SREG_Z);
        if (result & 0x80) sreg |= (1 << AVRISAInst::SREG_N); else sreg &= ~(1 << AVRISAInst::SREG_N);
        bool s = ((sreg >> AVRISAInst::SREG_N) & 1) ^ ((sreg >> AVRISAInst::SREG_V) & 1);
        if (s) sreg |= (1 << AVRISAInst::SREG_S); else sreg &= ~(1 << AVRISAInst::SREG_S);
        xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, rd), result);
        xc->setMiscReg(AVRISAInst::MISCREG_SREG, sreg);
    }});
    0x0c, 0x0d, 0x0e, 0x0f: Cpi::cpi({{ }});
    0x14, 0x15, 0x16, 0x17: Subi::subi({{ }});
    0x10, 0x11, 0x12, 0x13: Sbci::sbci({{ }});

    0x30, 0x31, 0x32, 0x33: RelativeJump::rjmp({{ }});
    0x34, 0x35, 0x36, 0x37: RelativeJump::rcall({{ }});
    0x3c: ConditionalBranch::brbs({{ }});
    0x3d: ConditionalBranch::brbc({{ }});

    0x2c, 0x2d: Basic::in_instr({{
        uint8_t addr = (IO_AH << 4) | IO_AL;
        uint8_t rd = IO_D;
        uint8_t val;
        // I/O 0x3d/0x3e/0x3f are the memory-mapped SPL/SPH/SREG registers.
        // SP and SREG are modeled as MiscRegs (the single source of truth used
        // by push/pop/call/ret and the arithmetic flag logic), so these I/O
        // ports must alias those MiscRegs rather than plain data memory.
        if (addr == 0x3d) { // SPL
            val = xc->readMiscReg(AVRISAInst::MISCREG_SP) & 0xFF;
        } else if (addr == 0x3e) { // SPH
            val = (xc->readMiscReg(AVRISAInst::MISCREG_SP) >> 8) & 0xFF;
        } else if (addr == 0x3f) { // SREG
            val = xc->readMiscReg(AVRISAInst::MISCREG_SREG) & 0xFF;
        } else if (addr == 0x3b) { // RAMPZ (extended Z high byte, used by ELPM)
            val = xc->readMiscReg(AVRISAInst::MISCREG_RAMPZ) & 0xFF;
        } else {
            xc->readMem(0x20 + addr, &val, 1, 0, {});
        }
        xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, rd), val);
    }});

    0x2e, 0x2f: Basic::out_instr({{
        uint8_t addr = (IO_AH << 4) | IO_AL;
        uint8_t rr = IO_D;
        RegVal val = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, rr));
        uint8_t val8 = (uint8_t)val;
        // I/O 0x3d/0x3e/0x3f alias the SPL/SPH/SREG MiscRegs (see in_instr).
        if (addr == 0x3d) { // SPL
            RegVal sp = xc->readMiscReg(AVRISAInst::MISCREG_SP);
            sp = (sp & ~(RegVal)0xFF) | val8;
            xc->setMiscReg(AVRISAInst::MISCREG_SP, sp);
        } else if (addr == 0x3e) { // SPH
            RegVal sp = xc->readMiscReg(AVRISAInst::MISCREG_SP);
            sp = (sp & (RegVal)0xFF) | ((RegVal)val8 << 8);
            xc->setMiscReg(AVRISAInst::MISCREG_SP, sp);
        } else if (addr == 0x3f) { // SREG
            xc->setMiscReg(AVRISAInst::MISCREG_SREG, val8);
        } else if (addr == 0x3b) { // RAMPZ (extended Z high byte, used by ELPM)
            xc->setMiscReg(AVRISAInst::MISCREG_RAMPZ, val8);
        } else {
            xc->writeMem(&val8, 1, 0x20 + addr, 0, nullptr, {});
        }
    }});

    0x38, 0x39, 0x3a, 0x3b: Basic::ldi({{
        uint8_t imm = (LDI_KH << 4) | LDI_KL;
        uint8_t rd = 16 + LDI_D;
        xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, rd), imm);
    }});

    0x27: Mul::mul({{ }});

    // OPCODE 0x26: SBI/CBI/SBIC/SBIS -- 1001 10xx AAAA Abbb.
    // I/O address A (0..31) maps to data address 0x20+A; bit b in 0..7. These
    // address only the low 32 (bit-addressable) I/O registers, never the
    // SPL/SPH/SREG ports (I/O 0x3d-0x3f), so no MiscReg aliasing is needed.
    // SBI/CBI read-modify-write the I/O byte (no SREG effect); SBIC/SBIS skip
    // the next instruction on the bit value (same convention as sbrc/sbrs).
    0x26: decode BIT9 {
        0x0: decode BIT8 {
            0x0: Basic::cbi({{ // 1001 1000: clear I/O bit
                uint8_t a = IOB_A, b = IOB_B, v;
                xc->readMem(0x20 + a, &v, 1, 0, {});
                v &= (uint8_t)~(1 << b);
                xc->writeMem(&v, 1, 0x20 + a, 0, nullptr, {});
            }});
            0x1: Basic::sbic({{ // 1001 1001: skip if I/O bit clear
                uint8_t a = IOB_A, b = IOB_B, v;
                xc->readMem(0x20 + a, &v, 1, 0, {});
                if (!((v >> b) & 1)) {
                    gem5::AVRISAInst::PCState pc =
                        xc->pcState().as<gem5::AVRISAInst::PCState>();
                    pc.advance();
                    xc->pcState(pc);
                }
            }});
            default: Unimplemented::op26_cbi_sbic_default({{ return nullptr; }});
        }
        0x1: decode BIT8 {
            0x0: Basic::sbi({{ // 1001 1010: set I/O bit
                uint8_t a = IOB_A, b = IOB_B, v;
                xc->readMem(0x20 + a, &v, 1, 0, {});
                v |= (uint8_t)(1 << b);
                xc->writeMem(&v, 1, 0x20 + a, 0, nullptr, {});
            }});
            0x1: Basic::sbis({{ // 1001 1011: skip if I/O bit set
                uint8_t a = IOB_A, b = IOB_B, v;
                xc->readMem(0x20 + a, &v, 1, 0, {});
                if ((v >> b) & 1) {
                    gem5::AVRISAInst::PCState pc =
                        xc->pcState().as<gem5::AVRISAInst::PCState>();
                    pc.advance();
                    xc->pcState(pc);
                }
            }});
            default: Unimplemented::op26_sbi_sbis_default({{ return nullptr; }});
        }
        default: Unimplemented::op26_bit9_default({{ return nullptr; }});
    }

    // OPCODE 0x20-0x23, 0x28-0x2B: LDD/STD with displacement
    0x20, 0x21, 0x22, 0x23, 0x28, 0x29, 0x2a, 0x2b: decode BIT3 {
        0x0: decode BIT9 { // Z+q
            0x0: Basic::ldd_z({{
                uint8_t q = ((machInst >> 8) & 0x20) | ((machInst >> 7) & 0x18) | (machInst & 0x07);
                uint8_t rd = (machInst >> 4) & 0x1F;
                RegVal zl = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, 30));
                RegVal zh = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, 31));
                Addr addr = (zh << 8) | zl;
                uint8_t val;
                xc->readMem(addr + q, &val, 1, 0, {});
                xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, rd), (RegVal)val);
            }});
            0x1: Basic::std_z({{
                uint8_t q = ((machInst >> 8) & 0x20) | ((machInst >> 7) & 0x18) | (machInst & 0x07);
                uint8_t rr = (machInst >> 4) & 0x1F;
                RegVal zl = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, 30));
                RegVal zh = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, 31));
                Addr addr = (zh << 8) | zl;
                RegVal val = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, rr));
                uint8_t val8 = (uint8_t)val;
                xc->writeMem(&val8, 1, addr + q, 0, nullptr, {});
            }});
            default: Unimplemented::ldd_z_default({{ return nullptr; }});
        }
        0x1: decode BIT9 { // Y+q
            0x0: Basic::ldd_y({{
                uint8_t q = ((machInst >> 8) & 0x20) | ((machInst >> 7) & 0x18) | (machInst & 0x07);
                uint8_t rd = (machInst >> 4) & 0x1F;
                RegVal yl = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, 28));
                RegVal yh = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, 29));
                Addr addr = (yh << 8) | yl;
                uint8_t val;
                xc->readMem(addr + q, &val, 1, 0, {});
                xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, rd), (RegVal)val);
            }});
            0x1: Basic::std_y({{
                uint8_t q = ((machInst >> 8) & 0x20) | ((machInst >> 7) & 0x18) | (machInst & 0x07);
                uint8_t rr = (machInst >> 4) & 0x1F;
                RegVal yl = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, 28));
                RegVal yh = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, 29));
                Addr addr = (yh << 8) | yl;
                RegVal val = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, rr));
                uint8_t val8 = (uint8_t)val;
                xc->writeMem(&val8, 1, addr + q, 0, nullptr, {});
            }});
            default: Unimplemented::ldd_y_default({{ return nullptr; }});
        }
        default: Unimplemented::ldd_bit3_default({{ return nullptr; }});
    }

    0x24: decode REG_R {
        0x0: decode BIT9 {
            0x0: Basic4Byte::lds({{
                uint8_t rd = DS_D;
                Addr addr = DS_K;
                uint8_t val8;
                xc->readMem(addr, &val8, 1, 0, {});
                xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, rd), val8);
            }});
            0x1: Basic4Byte::sts({{
                uint8_t rd = DS_D;
                RegVal val = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, rd));
                uint8_t val8 = (uint8_t)val;
                Addr addr = DS_K;
                xc->writeMem(&val8, 1, addr, 0, nullptr, {});
            }});
            default: Unimplemented::sts_lds_default({{ return nullptr; }});
        }
        0x1: decode BIT9 {
            0x0: Basic::ld_z_postinc({{
                uint8_t rd = REG_D;
                RegVal zl = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, 30));
                RegVal zh = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, 31));
                Addr addr = (zh << 8) | zl;
                uint8_t val8;
                xc->readMem(addr, &val8, 1, 0, {});
                xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, rd), (RegVal)val8);
                addr++;
                xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, 30), addr & 0xFF);
                xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, 31), (addr >> 8) & 0xFF);
            }});
            0x1: Basic::st_z_postinc({{
                uint8_t rr = REG_D;
                RegVal val = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, rr));
                uint8_t val8 = (uint8_t)val;
                RegVal zl = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, 30));
                RegVal zh = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, 31));
                Addr addr = (zh << 8) | zl;
                xc->writeMem(&val8, 1, addr, 0, nullptr, {});
                addr++;
                xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, 30), addr & 0xFF);
                xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, 31), (addr >> 8) & 0xFF);
            }});
            default: Unimplemented::ld_st_z_postinc_default({{ return nullptr; }});
        }
        0x2: decode BIT9 {
            0x0: Basic::ld_z_predec({{
                uint8_t rd = REG_D;
                RegVal zl = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, 30));
                RegVal zh = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, 31));
                Addr addr = ((zh << 8) | zl) - 1;
                uint8_t val8;
                xc->readMem(addr, &val8, 1, 0, {});
                xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, rd), (RegVal)val8);
                xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, 30), addr & 0xFF);
                xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, 31), (addr >> 8) & 0xFF);
            }});
            0x1: Basic::st_z_predec({{
                uint8_t rr = REG_D;
                RegVal val = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, rr));
                uint8_t val8 = (uint8_t)val;
                RegVal zl = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, 30));
                RegVal zh = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, 31));
                Addr addr = ((zh << 8) | zl) - 1;
                xc->writeMem(&val8, 1, addr, 0, nullptr, {});
                xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, 30), addr & 0xFF);
                xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, 31), (addr >> 8) & 0xFF);
            }});
            default: Unimplemented::ld_st_z_predec_default({{ return nullptr; }});
        }
        0x4: Basic::lpm_z({{
            uint8_t rd = REG_D;
            RegVal zl = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, 30));
            RegVal zh = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, 31));
            Addr addr = (zh << 8) | zl;
            uint8_t val;
            xc->readMem(addr, &val, 1, Request::INST_FETCH, {});
            xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, rd), (RegVal)val);
        }});
        0x5: Basic::lpm_z_postinc({{
            uint8_t rd = REG_D;
            RegVal zl = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, 30));
            RegVal zh = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, 31));
            Addr addr = (zh << 8) | zl;
            uint8_t val;
            xc->readMem(addr, &val, 1, Request::INST_FETCH, {});
            xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, rd), (RegVal)val);
            addr++;
            xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, 30), addr & 0xFF);
            xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, 31), (addr >> 8) & 0xFF);
        }});
        0x6: Basic::elpm_z({{ // ELPM Rd, Z  (load from RAMPZ:Z program memory)
            uint8_t rd = REG_D;
            RegVal zl = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, 30));
            RegVal zh = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, 31));
            RegVal rampz = xc->readMiscReg(AVRISAInst::MISCREG_RAMPZ) & 0xFF;
            Addr addr = (rampz << 16) | (zh << 8) | zl;
            uint8_t val;
            xc->readMem(addr, &val, 1, Request::INST_FETCH, {});
            xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, rd), (RegVal)val);
        }});
        0x7: Basic::elpm_z_postinc({{ // ELPM Rd, Z+  (post-increment 24-bit RAMPZ:Z)
            uint8_t rd = REG_D;
            RegVal zl = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, 30));
            RegVal zh = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, 31));
            RegVal rampz = xc->readMiscReg(AVRISAInst::MISCREG_RAMPZ) & 0xFF;
            Addr addr = (rampz << 16) | (zh << 8) | zl;
            uint8_t val;
            xc->readMem(addr, &val, 1, Request::INST_FETCH, {});
            xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, rd), (RegVal)val);
            addr++;
            xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, 30), addr & 0xFF);
            xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, 31), (addr >> 8) & 0xFF);
            xc->setMiscReg(AVRISAInst::MISCREG_RAMPZ, (addr >> 16) & 0xFF);
        }});
        0x9: decode BIT9 {
            0x0: Basic::ld_y_postinc({{
                uint8_t rd = REG_D;
                RegVal yl = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, 28));
