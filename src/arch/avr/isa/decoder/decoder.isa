    0x25: decode BIT9 {
        0x0: decode REG_R {
            0x0: Com::com({{ }});
            0x1: Neg::neg({{ }});
            0x2: Basic::swap({{
                uint8_t rd_idx = REG_D;
                RegVal val = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, rd_idx));
                uint8_t result = ((val & 0x0F) << 4) | ((val & 0xF0) >> 4);
                xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, rd_idx), result);
            }});
            0x3: Inc::inc({{ }});
            0x5: Basic::asr({{
                uint8_t rd_idx = REG_D;
                RegVal val = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, rd_idx));
                uint8_t carry = val & 1;
                uint8_t result = (val >> 1) | (val & 0x80);
                uint8_t sreg = xc->readMiscReg(AVRISAInst::MISCREG_SREG);
                if (carry) sreg |= (1 << AVRISAInst::SREG_C); else sreg &= ~(1 << AVRISAInst::SREG_C);
                if (result == 0) sreg |= (1 << AVRISAInst::SREG_Z); else sreg &= ~(1 << AVRISAInst::SREG_Z);
                if (result & 0x80) sreg |= (1 << AVRISAInst::SREG_N); else sreg &= ~(1 << AVRISAInst::SREG_N);
                bool n = (result & 0x80) != 0;
                bool v = n ^ carry;
                if (v) sreg |= (1 << AVRISAInst::SREG_V); else sreg &= ~(1 << AVRISAInst::SREG_V);
                bool s = n ^ v;
                if (s) sreg |= (1 << AVRISAInst::SREG_S); else sreg &= ~(1 << AVRISAInst::SREG_S);
                xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, rd_idx), result);
                xc->setMiscReg(AVRISAInst::MISCREG_SREG, sreg);
            }});
            0x6: Basic::lsr({{
                uint8_t rd_idx = REG_D;
                RegVal val = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, rd_idx));
                uint8_t carry = val & 1;
                uint8_t result = (val >> 1);
                uint8_t sreg = xc->readMiscReg(AVRISAInst::MISCREG_SREG);
                if (carry) sreg |= (1 << AVRISAInst::SREG_C); else sreg &= ~(1 << AVRISAInst::SREG_C);
                if (result == 0) sreg |= (1 << AVRISAInst::SREG_Z); else sreg &= ~(1 << AVRISAInst::SREG_Z);
                sreg &= ~(1 << AVRISAInst::SREG_N);
                bool n = false;
                bool v = n ^ carry;
                if (v) sreg |= (1 << AVRISAInst::SREG_V); else sreg &= ~(1 << AVRISAInst::SREG_V);
                bool s = n ^ v;
                if (s) sreg |= (1 << AVRISAInst::SREG_S); else sreg &= ~(1 << AVRISAInst::SREG_S);
                xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, rd_idx), result);
                xc->setMiscReg(AVRISAInst::MISCREG_SREG, sreg);
            }});
            0x7: Basic::ror_inst({{
                uint8_t rd_idx = REG_D;
                RegVal val = xc->tcBase()->getReg(RegId(AVRISAInst::intRegClass, rd_idx));
                uint8_t sreg = xc->readMiscReg(AVRISAInst::MISCREG_SREG);
                uint8_t old_carry = (sreg >> AVRISAInst::SREG_C) & 1;
                uint8_t carry = val & 1;
                uint8_t result = (val >> 1) | (old_carry << 7);
                if (carry) sreg |= (1 << AVRISAInst::SREG_C); else sreg &= ~(1 << AVRISAInst::SREG_C);
                if (result == 0) sreg |= (1 << AVRISAInst::SREG_Z); else sreg &= ~(1 << AVRISAInst::SREG_Z);
                if (result & 0x80) sreg |= (1 << AVRISAInst::SREG_N); else sreg &= ~(1 << AVRISAInst::SREG_N);
                bool n = (result & 0x80) != 0;
                bool v = n ^ carry;
                if (v) sreg |= (1 << AVRISAInst::SREG_V); else sreg &= ~(1 << AVRISAInst::SREG_V);
                bool s = n ^ v;
                if (s) sreg |= (1 << AVRISAInst::SREG_S); else sreg &= ~(1 << AVRISAInst::SREG_S);
                xc->tcBase()->setReg(RegId(AVRISAInst::intRegClass, rd_idx), result);
                xc->setMiscReg(AVRISAInst::MISCREG_SREG, sreg);
