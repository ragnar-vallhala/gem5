// decoder.isa

decode OPCODE default Unimplemented::decode_default({{
    // Default: unknown instruction — UnknownInstFault advances PC
    return std::make_shared<UnknownInstFault>();
}}) {

    // NOP: instruction word 0x0000
    // OPCODE=0x0 (bits[15:10]=000000)
    0x0: Basic::nop({{
        // No operation; advancePC handles the PC increment
    }});
    0x3: Add::add({{
        // Read source registers
        uint8_t rd = xc->readIntRegOperand(this, 0);
        uint8_t rr = xc->readIntRegOperand(this, 1);
        uint8_t result = rd + rr;

        // Read SREG
        uint8_t sreg = xc->readMiscRegOperand(this, MISCREG_SREG);

        // Update flags
        updateFlagsAdd(sreg, result, rd, rr);

        // Write results
        xc->setIntRegOperand(this, 0, result);
        xc->setMiscRegOperand(this, MISCREG_SREG, sreg);

        // Update PC
        PCState pc = xc->pcState();
        pc.increment();
        xc->pcState(pc);

        return NoFault;
    }});

    0x6: Sub::sub({{
        // Read source registers
        uint8_t rd = xc->readIntRegOperand(this, 0);
        uint8_t rr = xc->readIntRegOperand(this, 1);
        uint8_t result = rd - rr;

        // Read SREG
        uint8_t sreg = xc->readMiscRegOperand(this, MISCREG_SREG);

        // Update flags
        updateFlagsSub(sreg, result, rd, rr);

        // Write results
        xc->setIntRegOperand(this, 0, result);
        xc->setMiscRegOperand(this, MISCREG_SREG, sreg);

        // Update PC
        PCState pc = xc->pcState();
        pc.increment();
        xc->pcState(pc);

        return NoFault;
    }});

    // AVR SLEEP (0x9588), JMP (0x940c), CALL (0x940e) share OPCODE 0x25 (100101)
    0x25: decode OP_EXTRA {
        0x4: decode LOW_WORD default Unimplemented::op25_extra_default({{
            return std::make_shared<UnknownInstFault>();
        }}) {
            0x9588: Basic::sleep({{
                return std::make_shared<gem5::AVRISAInst::HaltFault>();
            }});
        }
        0x6: Jump::jmp({{ }});
        0x7: Jump::call({{ }});
        default: Unimplemented::op25_default({{
            return std::make_shared<UnknownInstFault>();
        }});
    }
}
