// -*- mode:c++ -*-

// Define templates first
def template JumpDecode {{
    return new %(class_name)s(machInst);
}};

def template JumpDeclare {{
    class %(class_name)s : public gem5::AVRISAInst::AVRStaticInst
    {
      public:
        %(class_name)s(gem5::AVRISAInst::MachInst machInst);
        Fault execute(ExecContext *, trace::InstRecord *) const override;
        std::string generateDisassembly(gem5::Addr pc,
            const gem5::loader::SymbolTable *symtab) const override;
        void advancePC(PCStateBase &pc_state) const;
    };
}};

def template JumpConstructor {{
    %(class_name)s::%(class_name)s(gem5::AVRISAInst::MachInst machInst)
        : gem5::AVRISAInst::AVRStaticInst("%(name)s", machInst, %(op_class)s)
    {
        _numSrcRegs = 0;
        _numDestRegs = 0;
        flags[IsControl] = true;
        flags[IsDirectControl] = true;
        if (std::string("%(name)s") == "call") {
            flags[IsCall] = true;
        }
    }

    void %(class_name)s::advancePC(PCStateBase &pc_state) const {
        // Handled in execute for jumps
    }

    std::string
    %(class_name)s::generateDisassembly(gem5::Addr pc,
        const gem5::loader::SymbolTable *symtab) const
    {
        std::stringstream ss;
        ss << "%(name)s 0x" << std::hex << (uint32_t)((JMP_H << 17) | (JMP_M << 16) | JMP_L);
        return ss.str();
    }
}};

def template JumpExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc, trace::InstRecord *traceData) const
    {
        uint32_t target = ((JMP_H << 17) | (JMP_M << 16) | JMP_L) << 1;

        if (std::string("%(name)s") == "call") {
            // Push return address to stack (PC + 4)
            Addr pc = xc->pcState().instAddr();
            Addr return_addr = pc + 4;
            Addr sp = xc->readMiscReg(AVRISAInst::MISCREG_SP);

            uint8_t high = (return_addr >> 8) & 0xFF;
            uint8_t low = return_addr & 0xFF;

            // Standard AVR: push high then low
            xc->writeMem(&high, 1, sp, 0, nullptr, {});
            xc->writeMem(&low, 1, sp - 1, 0, nullptr, {});

            xc->setMiscReg(AVRISAInst::MISCREG_SP, sp - 2);
        }

        auto pc = xc->pcState().as<gem5::AVRISAInst::PCState>();
        pc.set(target);
        xc->pcState(pc);

        return NoFault;
    }
}};

def template RelativeJumpDeclare {{
    // Already declared in JumpDeclare
}};

def template RelativeJumpExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc, trace::InstRecord *traceData) const
    {
        // 12-bit signed offset in words
        int32_t offset = REL_K;
        if (offset & 0x800) {
            offset |= 0xFFFFF000;
        }

        // Relative to PC + 2
        Addr pc_val = xc->pcState().instAddr();
        Addr target = pc_val + 2 + (offset << 1);

        if (std::string("%(name)s") == "rcall") {
             Addr return_addr = pc_val + 2;
             Addr sp = xc->readMiscReg(AVRISAInst::MISCREG_SP);
             uint8_t high = (return_addr >> 8) & 0xFF;
             uint8_t low = return_addr & 0xFF;

             // Standard AVR: push high then low
             xc->writeMem(&high, 1, sp, 0, nullptr, {});
             xc->writeMem(&low, 1, sp - 1, 0, nullptr, {});
             xc->setMiscReg(AVRISAInst::MISCREG_SP, sp - 2);
        }

        auto pc = xc->pcState().as<gem5::AVRISAInst::PCState>();
        pc.set(target);
        xc->pcState(pc);

        return NoFault;
    }
}};

def template ConditionalBranchExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc, trace::InstRecord *traceData) const
    {
        uint8_t s = BR_S;
        uint8_t sreg = xc->readMiscReg(AVRISAInst::SREG_Idx);
        bool set = (sreg >> s) & 1;
        bool branch = false;

        if (std::string("%(name)s") == "brbs") {
            if (set) branch = true;
        } else { // brbc
            if (!set) branch = true;
        }

        auto pc = xc->pcState().as<gem5::AVRISAInst::PCState>();
        if (branch) {
            int32_t offset = BR_K;
            if (offset & 0x40) {
                offset |= 0xFFFFFF80;
            }
            Addr pc_val = xc->pcState().instAddr();
            Addr target = pc_val + 2 + (offset << 1);
            pc.set(target);
        } else {
            pc.advance();
        }
        xc->pcState(pc);

        return NoFault;
    }
}};

// Then define formats
def format Jump(code, *opt_args) {{
    iop = InstObjParams(name, Name, 'AVRStaticInst',
                       {'code': code,
                        'predicate_test': predicateTest,
                        'op_class': 'gem5::enums::IntAlu',
                        'name': name
                       },
                       opt_args)
    header_output = JumpDeclare.subst(iop)
    decoder_output = JumpConstructor.subst(iop)
    decode_block = JumpDecode.subst(iop)
    exec_output = JumpExecute.subst(iop)
}};

def format RelativeJump(code, *opt_args) {{
    iop = InstObjParams(name, Name, 'AVRStaticInst',
                       {'code': code,
                        'predicate_test': predicateTest,
                        'op_class': 'gem5::enums::IntAlu',
                        'name': name
                       },
                       opt_args)
    header_output = JumpDeclare.subst(iop)
    header_output += RelativeJumpDeclare.subst(iop)
    decoder_output = JumpConstructor.subst(iop)
    decode_block = JumpDecode.subst(iop)
    exec_output = RelativeJumpExecute.subst(iop)
}};

def format Return(code, *opt_args) {{
    iop = InstObjParams(name, Name, 'AVRStaticInst',
                       {'code': code,
                        'predicate_test': predicateTest,
                        'op_class': 'gem5::enums::IntAlu',
                        'name': name
                       },
                       opt_args)
    header_output = JumpDeclare.subst(iop)
    decoder_output = JumpConstructor.subst(iop)
    decode_block = JumpDecode.subst(iop)
    exec_output = BasicExecute.subst(iop)
}};

def format ConditionalBranch(code, *opt_args) {{
    iop = InstObjParams(name, Name, 'AVRStaticInst',
                       {'code': code,
                        'predicate_test': predicateTest,
                        'op_class': 'gem5::enums::IntAlu',
                        'name': name
                       },
                       opt_args)
    header_output = JumpDeclare.subst(iop)
    decoder_output = JumpConstructor.subst(iop)
    decode_block = JumpDecode.subst(iop)
    exec_output = ConditionalBranchExecute.subst(iop)
}};
